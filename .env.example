# Copier ce fichier en .env pour le développement local. Ne jamais versionner le fichier .env.

# Port d'écoute (fourni par l'hébergeur en ligne)
PORT=3000
# production en ligne
NODE_ENV=development

# Base PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/masterclass
# true seulement si la base est jointe par son adresse publique (inutile sur le réseau privé de l'hébergeur)
DATABASE_SSL=false

# Nombre de places : au-delà, l'événement est complet
CAPACITE=200
# Clôture des inscriptions (heure d'Ouagadougou = UTC)
CLOTURE_INSCRIPTIONS=2026-10-16T23:59:59Z

# Espace de l'équipe organisatrice (/equipe) : mot de passe de 12 caractères au moins
ADMIN_PASSWORD=
# Secret de signature des sessions : chaîne aléatoire de 32 caractères au moins
SESSION_SECRET=

# Adresse publique du site, sans barre finale (facultatif : sert aux liens des billets)
PUBLIC_URL=
